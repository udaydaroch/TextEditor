@page "/folders/{FolderId:int}"
@using TextEditor.Services
@using TextEditor.Models
@rendermode InteractiveServer
@inject IFolderService FolderService
@inject IDocumentService DocumentService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@(folder?.Name ?? "Folder")</PageTitle>

@if (folder is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="mb-3">
        <button class="btn btn-secondary" @onclick="GoBack">
            <i class="bi bi-arrow-left"></i> Back to Folders
        </button>
        <button class="btn btn-primary" @onclick="CreateNewDocument">
            <i class="bi bi-file-earmark-plus"></i> New Document in this Folder
        </button>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h2><i class="bi bi-folder-fill text-warning"></i> @folder.Name</h2>
            @if (!string.IsNullOrEmpty(folder.Description))
            {
                <p class="text-muted mb-0">@folder.Description</p>
            }
        </div>
    </div>

    @if (documents == null)
    {
        <p><em>Loading documents...</em></p>
    }
    else if (!documents.Any())
    {
        <div class="alert alert-info">
            This folder is empty. Create a new document to get started!
        </div>
    }
    else
    {
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Created</th>
                    <th>Last Modified</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var doc in documents)
                {
                    <tr>
                        <td>@doc.Title</td>
                        <td>@doc.CreatedDate.ToString("MMM dd, yyyy HH:mm")</td>
                        <td>@doc.LastModifiedDate.ToString("MMM dd, yyyy HH:mm")</td>
                        <td>
                            <button class="btn btn-sm btn-info" @onclick="() => ViewDocument(doc.Id)">View</button>
                            <button class="btn btn-sm btn-warning" @onclick="() => EditDocument(doc.Id)">Edit</button>
                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteDocument(doc.Id)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    [Parameter]
    public int FolderId { get; set; }

    private Folder? folder;
    private List<Document>? documents;

    protected override async Task OnInitializedAsync()
    {
        folder = await FolderService.GetFolderByIdAsync(FolderId);
        if (folder == null)
        {
            Navigation.NavigateTo("/");
            return;
        }

        documents = await DocumentService.GetDocumentsByFolderIdAsync(FolderId);
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/");
    }

    private void CreateNewDocument()
    {
        Navigation.NavigateTo($"/documents/edit/0?folderId={FolderId}");
    }

    private void ViewDocument(int id)
    {
        Navigation.NavigateTo($"/documents/view/{id}");
    }

    private void EditDocument(int id)
    {
        Navigation.NavigateTo($"/documents/edit/{id}");
    }

    private async Task DeleteDocument(int id)
    {
        if (await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this document?"))
        {
            await DocumentService.DeleteDocumentAsync(id);
            documents = await DocumentService.GetDocumentsByFolderIdAsync(FolderId);
        }
    }
}