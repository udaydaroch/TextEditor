@page "/documents/view/{Id:int}"
@inject IDocumentService DocumentService
@inject NavigationManager Navigation

@rendermode InteractiveServer

@if (document == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="mb-3">
        <button class="btn btn-secondary" @onclick="GoBack">
            <i class="bi bi-arrow-left"></i> Back to Documents
        </button>
        <button class="btn btn-warning" @onclick="EditDocument">
            <i class="bi bi-pencil"></i> Edit
        </button>
    </div>

    <div class="card">
        <div class="card-header">
            <h2>@document.Title</h2>
            <small class="text-muted">
                Created: @document.CreatedDate.ToString("MMM dd, yyyy HH:mm") | 
                Last Modified: @document.LastModifiedDate.ToString("MMM dd, yyyy HH:mm")
            </small>
        </div>
        <div class="card-body">
            <pre style="white-space: pre-wrap; font-family: inherit;">@document.Content</pre>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Document? document;

    protected override async Task OnInitializedAsync()
    {
        document = await DocumentService.GetDocumentByIdAsync(Id);
        if (document == null)
        {
            Navigation.NavigateTo("/documents");
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/documents");
    }

    private void EditDocument()
    {
        Navigation.NavigateTo($"/documents/edit/{Id}");
    }
}