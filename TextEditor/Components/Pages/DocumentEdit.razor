@page "/documents/edit/{Id:int}"
@page "/documents/view/{Id:int}"
@using TextEditor.Models
@using TextEditor.Services
@rendermode InteractiveServer
@inject IDocumentService DocumentService
@inject IFolderService FolderService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>
            <i class="bi bi-file-text"></i>
            @(string.IsNullOrEmpty(document.Title) ? "Untitled Document" : document.Title)
        </h3>
        <div>
            @if (isEditMode)
            {
                <button class="btn btn-success me-2" @onclick="Save" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    <i class="bi bi-save"></i> Save
                </button>
                <button class="btn btn-outline-secondary me-2" @onclick="ToggleEditMode">
                    <i class="bi bi-eye"></i> View Mode
                </button>
            }
            else
            {
                <button class="btn btn-warning me-2" @onclick="ToggleEditMode">
                    <i class="bi bi-pencil"></i> Edit
                </button>
                
            }
            <button class="btn btn-outline-primary me-2" @onclick="DownloadDocx">
                <i class="bi bi-file-earmark-word-fill"></i> DOCX
            </button>
            <button class="btn btn-outline-danger me-2" @onclick="DownloadPdf">
                <i class="bi bi-file-earmark-pdf-fill"></i> PDF
            </button>
            <button class="btn btn-secondary" @onclick="GoBack">
                <i class="bi bi-arrow-left"></i> Back
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-@(isError ? "danger" : "success") alert-dismissible fade show">
            @message
            <button type="button" class="btn-close" @onclick="() => message = string.Empty"></button>
        </div>
    }

    @if (isEditMode)
    {
        <!-- EDIT MODE -->
        <div class="row mb-3">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Title <span class="text-danger">*</span></label>
                            <input type="text" 
                                   class="form-control form-control-lg" 
                                   @bind="document.Title" 
                                   @bind:event="oninput"
                                   placeholder="Untitled Document" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Folder</label>
                            <select class="form-select" @bind="document.FolderId">
                                <option value="">-- No Folder (Unfiled) --</option>
                                @if (folders != null)
                                {
                                    @foreach (var folder in folders)
                                    {
                                        <option value="@folder.Id">📁 @folder.Name</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h6 class="mb-0">Document Info</h6>
                    </div>
                    <div class="card-body">
                        @if (!isNewDocument && document.Id > 0)
                        {
                            <p class="mb-2">
                                <small class="text-muted">
                                    <i class="bi bi-calendar-plus"></i> Created:<br/>
                                    <strong>@document.CreatedDate.ToString("MMM dd, yyyy HH:mm")</strong>
                                </small>
                            </p>
                            <p class="mb-0">
                                <small class="text-muted">
                                    <i class="bi bi-calendar-check"></i> Last Modified:<br/>
                                    <strong>@document.LastModifiedDate.ToString("MMM dd, yyyy HH:mm")</strong>
                                </small>
                            </p>
                        }
                        else
                        {
                            <p class="text-muted mb-0">
                                <i class="bi bi-info-circle"></i> New document
                            </p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-body p-0">
                <!-- Quill Editor Container -->
                <div id="editor" style="height: 500px; border: none;"></div>
            </div>
        </div>
    }
    else
    {
        <!-- VIEW MODE -->
        <div class="row mb-3">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                @if (document.FolderId.HasValue && folders != null)
                                {
                                    var folder = folders.FirstOrDefault(f => f.Id == document.FolderId.Value);
                                    if (folder != null)
                                    {
                                        <span class="badge bg-warning text-dark me-2">
                                            <i class="bi bi-folder-fill"></i> @folder.Name
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-secondary me-2">
                                        <i class="bi bi-inbox"></i> Unfiled
                                    </span>
                                }
                            </div>
                            <div>
                                <small class="text-muted me-3">
                                    <i class="bi bi-calendar-plus"></i> Created: <strong>@document.CreatedDate.ToString("MMM dd, yyyy HH:mm")</strong>
                                </small>
                                <small class="text-muted">
                                    <i class="bi bi-calendar-check"></i> Modified: <strong>@document.LastModifiedDate.ToString("MMM dd, yyyy HH:mm")</strong>
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <!-- Render HTML content -->
                <div class="document-content">
                    @if (!string.IsNullOrEmpty(document.Content))
                    {
                        @((MarkupString)document.Content)
                    }
                    else
                    {
                        <p class="text-muted">This document is empty.</p>
                    }
                </div>
            </div>
        </div>
    }
</div>

<style>
    /* Quill Editor Styles */
    .ql-container {
        font-size: 16px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .ql-editor {
        min-height: 500px;
    }

    .ql-toolbar.ql-snow {
        border: none;
        border-bottom: 1px solid #dee2e6;
        background-color: #f8f9fa;
    }

    .ql-container.ql-snow {
        border: none;
    }

    /* View Mode Styles */
    .document-content {
        font-size: 16px;
        line-height: 1.6;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        min-height: 400px;
        padding: 20px;
    }

    .document-content h1 { font-size: 2em; margin-top: 0.67em; margin-bottom: 0.67em; font-weight: bold; }
    .document-content h2 { font-size: 1.5em; margin-top: 0.83em; margin-bottom: 0.83em; font-weight: bold; }
    .document-content h3 { font-size: 1.17em; margin-top: 1em; margin-bottom: 1em; font-weight: bold; }
    .document-content p { margin-bottom: 1em; }
    .document-content ul, .document-content ol { margin-left: 1.5em; margin-bottom: 1em; }
    .document-content blockquote { 
        border-left: 4px solid #ddd; 
        padding-left: 1em; 
        margin: 1em 0; 
        color: #666; 
        font-style: italic;
    }
    .document-content pre { 
        background: #f4f4f4; 
        padding: 1em; 
        border-radius: 4px; 
        overflow-x: auto; 
        font-family: 'Courier New', monospace;
    }
    .document-content img { max-width: 100%; height: auto; }
    .document-content a { color: #0d6efd; text-decoration: underline; }
</style>

@code {
    [Parameter]
    public int Id { get; set; }

    [SupplyParameterFromQuery]
    public int? FolderId { get; set; }

    private Document document = new();
    private List<Folder>? folders;
    private bool isNewDocument => Id == 0;
    private string message = string.Empty;
    private bool isError = false;
    private bool isSaving = false;
    private bool isInitialized = false;
    private bool isEditMode = true;

    protected override async Task OnInitializedAsync()
    {
        folders = await FolderService.GetAllFoldersAsync();

        // Check if this is a view or edit route
        var uri = Navigation.Uri;
        isEditMode = uri.Contains("/edit/");

        if (!isNewDocument)
        {
            var existingDoc = await DocumentService.GetDocumentByIdAsync(Id);
            if (existingDoc != null)
            {
                document = existingDoc;
            }
            else
            {
                Navigation.NavigateTo("/");
                return;
            }
        }
        else
        {
            // New documents always start in edit mode
            isEditMode = true;
            if (FolderId.HasValue)
            {
                document.FolderId = FolderId.Value;
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && isEditMode && !isInitialized)
        {
            try
            {
                await JS.InvokeVoidAsync("initQuill", "editor");
                
                if (!string.IsNullOrEmpty(document.Content))
                {
                    await JS.InvokeVoidAsync("setQuillContent", document.Content);
                }
                
                isInitialized = true;
            }
            catch (Exception ex)
            {
                message = $"Error initializing editor: {ex.Message}";
                isError = true;
            }
        }
    }

    private async Task ToggleEditMode()
    {
        if (isEditMode)
        {
            // Switching from Edit to View - save content first
            try
            {
                document.Content = await JS.InvokeAsync<string>("getQuillContent");
                await JS.InvokeVoidAsync("destroyQuill");
                isInitialized = false;
            }
            catch { }
        }

        isEditMode = !isEditMode;

        if (isEditMode && !isInitialized)
        {
            // Reinitialize editor when switching back to edit mode
            StateHasChanged();
            await Task.Delay(100); // Give UI time to render
            
            try
            {
                await JS.InvokeVoidAsync("initQuill", "editor");
                
                if (!string.IsNullOrEmpty(document.Content))
                {
                    await JS.InvokeVoidAsync("setQuillContent", document.Content);
                }
                
                isInitialized = true;
            }
            catch (Exception ex)
            {
                message = $"Error initializing editor: {ex.Message}";
                isError = true;
            }
        }
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(document.Title))
        {
            message = "Please enter a document title";
            isError = true;
            return;
        }

        isSaving = true;
        isError = false;

        try
        {
            // Get content from Quill editor
            document.Content = await JS.InvokeAsync<string>("getQuillContent");

            if (isNewDocument)
            {
                var created = await DocumentService.CreateDocumentAsync(document);
                document = created; // Update with the created document (has ID now)
                message = "Document created successfully!";
                
                // Update URL to reflect the new document ID
                Navigation.NavigateTo($"/documents/edit/{document.Id}", false);
            }
            else
            {
                await DocumentService.UpdateDocumentAsync(document);
                message = "Document saved successfully!";
            }

            await Task.Delay(2000);
            message = string.Empty;
        }
        catch (Exception ex)
        {
            message = $"Error saving document: {ex.Message}";
            isError = true;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void GoBack()
    {
        if (document.FolderId.HasValue)
        {
            Navigation.NavigateTo($"/folders/{document.FolderId.Value}");
        }
        else
        {
            Navigation.NavigateTo("/");
        }
    }

    private async Task DownloadPdf()
    {
        string contentHtml;

        if (isEditMode)
        {
            try
            {
                contentHtml = await JS.InvokeAsync<string>("getQuillContent");
            }
            catch
            {
                contentHtml = document.Content ?? "<p style='color: #6c757d; font-style: italic;'>This document is empty.</p>";
            }
        }
        else
        {
            contentHtml = document.Content ?? "<p style='color: #6c757d; font-style: italic;'>This document is empty.</p>";
        }

        string title = string.IsNullOrWhiteSpace(document.Title) ? "Untitled Document" : document.Title.Trim();

        var createdFormatted  = document.CreatedDate.ToString("MMMM d, yyyy 'at' HH:mm");
        var modifiedFormatted = document.LastModifiedDate.ToString("MMMM d, yyyy 'at' HH:mm");

        // ────────────────────────────────────────────────────────────────
        // Modern, clean, professional PDF template
        // ────────────────────────────────────────────────────────────────
        var fullHtml = $@"
        <!DOCTYPE html>
        <html lang=""en"">
        <head>
            <meta charset=""UTF-8"">
            <title>{System.Web.HttpUtility.HtmlEncode(title)}</title>
            <style>
                @page {{
                    size: A4;
                    margin: 2.5cm 2cm 2.5cm 2cm;   /* generous margins for clean look */
                }}

                body {{
                    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
                    font-size: 11pt;
                    line-height: 1.65;
                    color: #1a1a1a;
                    margin: 0;
                    padding: 0;
                    background: #fff;
                }}

                .container {{
                    max-width: 100%;
                    margin: 0 auto;
                }}

                .header {{
                    text-align: center;
                    margin-bottom: 2.8cm;
                    padding-bottom: 1.2cm;
                    border-bottom: 1px solid #e0e0e0;
                }}

                .title {{
                    font-size: 28pt;
                    font-weight: 600;
                    margin: 0 0 0.4em;
                    color: #111;
                    letter-spacing: -0.5px;
                }}

                .meta {{
                    font-size: 9.5pt;
                    color: #555;
                    margin: 0.6em 0 0;
                }}

                .meta span {{
                    margin: 0 0.8em;
                }}

                .content {{
                    margin-top: 1.8cm;
                }}

                .content h1 {{ font-size: 22pt; margin: 1.4em 0 0.7em; color: #000; }}
                .content h2 {{ font-size: 18pt; margin: 1.2em 0 0.6em; color: #111; }}
                .content h3 {{ font-size: 15pt; margin: 1.1em 0 0.5em; color: #222; }}
                .content p  {{ margin: 0.9em 0; }}
                .content ul, .content ol {{ margin: 0.8em 0 0.8em 1.6em; padding-left: 0; }}
                .content li {{ margin-bottom: 0.4em; }}
                .content blockquote {{
                    margin: 1.4em 0;
                    padding-left: 1.2em;
                    border-left: 4px solid #ccc;
                    color: #444;
                    font-style: italic;
                }}
                .content pre {{
                    background: #f8f9fa;
                    padding: 1.1em;
                    border-radius: 5px;
                    overflow-x: auto;
                    font-family: 'Consolas', 'Courier New', monospace;
                    font-size: 9.8pt;
                    margin: 1.2em 0;
                }}
                .content code {{
                    background: #f1f1f1;
                    padding: 0.2em 0.4em;
                    border-radius: 3px;
                    font-family: 'Consolas', monospace;
                }}
                .content img {{
                    max-width: 100%;
                    height: auto;
                    display: block;
                    margin: 1.2em auto;
                    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
                }}
                .content a {{
                    color: #0066cc;
                    text-decoration: underline;
                }}

                .empty-message {{
                    text-align: center;
                    color: #888;
                    font-style: italic;
                    margin: 4cm 0;
                }}
            </style>
        </head>
        <body>
            <div class=""container"">
                <div class=""header"">
                    <h1 class=""title"">{System.Web.HttpUtility.HtmlEncode(title)}</h1>
                    <div class=""meta"">
                        <span>Created: {createdFormatted}</span>
                        <span>•</span>
                        <span>Last modified: {modifiedFormatted}</span>
                    </div>
                </div>

                <div class=""content"">
                    {(string.IsNullOrWhiteSpace(contentHtml) 
                        ? "<p class='empty-message'>This document contains no content yet.</p>" 
                        : contentHtml)}
                </div>
            </div>
        </body>
        </html>";

        try
        {
            await JS.InvokeVoidAsync("printHtmlAsPdf", fullHtml, $"{title}.pdf");
        }
        catch (Exception ex)
        {
            // You can show a message to the user here
            Console.WriteLine($"PDF generation failed: {ex.Message}");
        }
    }

    private async Task DownloadDocx()
    {
        string contentHtml;

        if (isEditMode)
        {
            try
            {
                contentHtml = await JS.InvokeAsync<string>("getQuillContent");
            }
            catch
            {
                contentHtml = document.Content ?? "<p style='color: #6c757d; font-style: italic;'>This document is empty.</p>";
            }
        }
        else
        {
            contentHtml = document.Content ?? "<p style='color: #6c757d; font-style: italic;'>This document is empty.</p>";
        }

        string title = string.IsNullOrWhiteSpace(document.Title) ? "Untitled Document" : document.Title.Trim();

        var createdFormatted  = document.CreatedDate.ToString("MMMM d, yyyy 'at' HH:mm");
        var modifiedFormatted = document.LastModifiedDate.ToString("MMMM d, yyyy 'at' HH:mm");

        // DOCX-friendly HTML – similar to PDF but simpler (no fancy @page, fewer CSS tricks)
        // html-to-docx supports many styles but prefers clean HTML
        var docxHtml = $@"
        <html>
        <head>
            <meta charset=""UTF-8"">
            <title>{System.Web.HttpUtility.HtmlEncode(title)}</title>
            <style>
                body {{
                    font-family: 'Segoe UI', Calibri, Arial, sans-serif;
                    font-size: 11pt;
                    line-height: 1.5;
                    color: #1a1a1a;
                }}
                h1 {{ font-size: 22pt; margin: 1.2em 0 0.6em; color: #000; }}
                h2 {{ font-size: 18pt; margin: 1em 0 0.5em; color: #111; }}
                h3 {{ font-size: 15pt; margin: 0.9em 0 0.4em; color: #222; }}
                p  {{ margin: 0.8em 0; }}
                ul, ol {{ margin: 0.7em 0 0.7em 1.8em; }}
                li {{ margin-bottom: 0.3em; }}
                blockquote {{
                    margin: 1.2em 0;
                    padding-left: 1.1em;
                    border-left: 4px solid #ccc;
                    color: #444;
                    font-style: italic;
                }}
                pre {{
                    background: #f8f9fa;
                    padding: 1em;
                    border-radius: 4px;
                    font-family: Consolas, 'Courier New', monospace;
                    font-size: 10pt;
                    overflow-x: auto;
                    margin: 1em 0;
                }}
                code {{ background: #f1f1f1; padding: 0.2em 0.4em; border-radius: 3px; }}
                img {{ max-width: 100%; height: auto; display: block; margin: 1em auto; }}
                a {{ color: #0066cc; text-decoration: underline; }}
                .meta {{
                    font-size: 9pt;
                    color: #555;
                    margin-bottom: 2em;
                    text-align: center;
                }}
                .empty-message {{
                    text-align: center;
                    color: #888;
                    font-style: italic;
                    margin: 3em 0;
                }}
            </style>
        </head>
        <body>
            <h1 style='text-align:center; margin-bottom:0.4em;'>{System.Web.HttpUtility.HtmlEncode(title)}</h1>
            <div class='meta'>
                Created: {createdFormatted} • Last modified: {modifiedFormatted}
            </div>

            {(string.IsNullOrWhiteSpace(contentHtml) 
                ? "<p class='empty-message'>This document contains no content yet.</p>" 
                : contentHtml)}
        </body>
        </html>";

        try
        {
            // Use InvokeVoidAsync instead of expecting a return value
            await JS.InvokeVoidAsync("generateAndDownloadDocx", docxHtml, $"{title}.docx");

            // If we reach here → no interop exception → treat as success
            message = "DOCX downloaded successfully!";
            isError = false;
        }
        catch (Exception ex)
        {
            message = $"Error generating DOCX: {ex.Message}";
            isError = true;
            Console.WriteLine($"DOCX interop error: {ex}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (isInitialized)
            {
                await JS.InvokeVoidAsync("destroyQuill");
            }
        }
        catch
        {
            // Ignore errors during cleanup
        }
    }
}