@page "/documents"
@using TextEditor.Models
@using TextEditor.Services
@rendermode InteractiveServer

@inject IDocumentService DocumentService
@inject IFolderService FolderService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<h3>All Documents</h3>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="CreateNew">
        <i class="bi bi-plus"></i> Create New Document
    </button>
    <button class="btn btn-secondary" @onclick="GoHome">
        <i class="bi bi-house"></i> Back to Folders
    </button>
</div>

@if (documents == null || folders == null)
{
    <p><em>Loading...</em></p>
}
else if (!documents.Any())
{
    <div class="alert alert-info">
        No documents yet. Create your first document!
    </div>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Title</th>
                <th>Folder</th>
                <th>Created</th>
                <th>Last Modified</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var doc in documents)
            {
                <tr>
                    <td>@doc.Title</td>
                    <td>
                        @if (doc.FolderId.HasValue)
                        {
                            var folder = folders.FirstOrDefault(f => f.Id == doc.FolderId.Value);
                            if (folder != null)
                            {
                                <span class="badge bg-warning text-dark">
                                    <i class="bi bi-folder-fill"></i> @folder.Name
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Unknown Folder</span>
                            }
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                <i class="bi bi-inbox"></i> Unfiled
                            </span>
                        }
                    </td>
                    <td>@doc.CreatedDate.ToString("MMM dd, yyyy HH:mm")</td>
                    <td>@doc.LastModifiedDate.ToString("MMM dd, yyyy HH:mm")</td>
                    <td>
                        <button class="btn btn-sm btn-info" @onclick="() => ViewDocument(doc.Id)">View</button>
                        <button class="btn btn-sm btn-warning" @onclick="() => EditDocument(doc.Id)">Edit</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteDocument(doc.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Document>? documents;
    private List<Folder>? folders;

    protected override async Task OnInitializedAsync()
    {
        await LoadDocuments();
        await LoadFolders();
    }

    private async Task LoadDocuments()
    {
        documents = await DocumentService.GetAllDocumentsAsync();
    }

    private async Task LoadFolders()
    {
        folders = await FolderService.GetAllFoldersAsync();
    }

    private void CreateNew()
    {
        Navigation.NavigateTo("/documents/edit/0");
    }

    private void GoHome()
    {
        Navigation.NavigateTo("/");
    }

    private void ViewDocument(int id)
    {
        Navigation.NavigateTo($"/documents/view/{id}");
    }

    private void EditDocument(int id)
    {
        Navigation.NavigateTo($"/documents/edit/{id}");
    }

    private async Task DeleteDocument(int id)
    {
        if (await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this document?"))
        {
            await DocumentService.DeleteDocumentAsync(id);
            await LoadDocuments();
        }
    }
}